rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Authorized Institute Administrators: mdausafmohiuddin@gmail.com AND jaferbhelmig@gmail.com
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'mdausafmohiuddin@gmail.com' ||
        request.auth.token.email.lower() == 'jaferbhelmig@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for Student entity
    function isValidStudent(data) {
      return data.keys().hasAll([
        'uid', 'studentId', 'fullName', 'phoneNumber', 'fatherName', 'motherName', 'email', 'batchId', 'batchName'
      ]) &&
      data.keys().hasOnly([
        'uid', 'studentId', 'fullName', 'phoneNumber', 'fatherName', 'motherName', 'email', 'batchId', 'batchName', 'createdAt', 'updatedAt', 'readAnnouncementIds'
      ]) &&
      data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
      data.studentId is string && data.studentId.size() <= 32 && data.studentId.matches('^ASDC-[0-9]{4,}$') &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
      data.phoneNumber is string && data.phoneNumber.size() >= 10 && data.phoneNumber.size() <= 15 && data.phoneNumber.matches('^[0-9]{10}$') &&
      data.fatherName is string && data.fatherName.size() >= 2 && data.fatherName.size() <= 100 &&
      data.motherName is string && data.motherName.size() >= 2 && data.motherName.size() <= 100 &&
      data.email is string && data.email.size() <= 150 && data.email.lower() == request.auth.token.email.lower() &&
      data.batchId is string && data.batchId.size() <= 50 &&
      data.batchName is string && data.batchName.size() <= 100;
    }

    // Validation for AttendanceRecord (Anytime Attendance Allowed)
    function isValidAttendance(data) {
      return data.keys().hasAll([
        'studentUid', 'studentId', 'studentName', 'studentEmail', 'classDate', 'batchId', 'status', 'source'
      ]) &&
      data.keys().hasOnly([
        'id', 'studentUid', 'studentId', 'studentName', 'studentEmail', 'classDate', 'batchId', 'status', 'source',
        'verifiedAt', 'submittedAt', 'timestamp', 'eventId', 'locationVerification', 'qrValidation',
        'dbCommitStatus', 'excelSyncStatus', 'finalizationStatus', 'correctionReason'
      ]) &&
      data.studentUid is string && data.studentUid.size() <= 128 &&
      data.studentId is string && data.studentId.size() <= 32 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.studentName is string && data.studentName.size() <= 100 &&
      data.studentEmail is string && data.studentEmail.size() <= 150 &&
      data.classDate is string && data.classDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.batchId is string && data.batchId.size() <= 50 &&
      data.status in ['PRESENT', 'ABSENT', 'EXCUSED', 'P', 'A'] &&
      data.source in ['QR_SCAN', 'ADMIN_MANUAL'];
    }

    // Validation for Announcement
    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'message', 'category', 'createdAt']) &&
      data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
      data.message is string && data.message.size() >= 5 && data.message.size() <= 2000 &&
      data.category in ['GENERAL', 'HOLIDAY', 'SCHEDULE', 'URGENT'];
    }

    // Validation for Holiday
    function isValidHoliday(data) {
      return data.keys().hasAll(['date', 'title']) &&
      data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 100;
    }

    // Student Profiles
    match /students/{studentUid} {
      allow get: if isSignedIn() && (request.auth.uid == studentUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(studentUid) && ((request.auth.uid == studentUid && isValidStudent(incoming())) || isAdmin());
      allow update: if isSignedIn() && isValidId(studentUid) && (
        isAdmin() ||
        (
          request.auth.uid == studentUid &&
          incoming().studentId == existing().studentId &&
          incoming().uid == existing().uid &&
          incoming().email.lower() == existing().email.lower() &&
          incoming().batchId == existing().batchId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['phoneNumber', 'updatedAt', 'readAnnouncementIds'])
        )
      );
      allow delete: if isAdmin();
    }

    // Counters for atomic student ID generation
    match /counters/{counterId} {
      allow get: if isSignedIn() && isValidId(counterId);
      allow list: if false;
      allow write: if isSignedIn() && isValidId(counterId);
    }

    // Attendance records (Accessible anytime, single record per student/date, only owner/admin)
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        (resource == null && attendanceId.matches('^' + request.auth.uid + '_.*')) ||
        (resource != null && resource.data.studentUid == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isAdmin() || (resource != null && resource.data.studentUid == request.auth.uid)
      );
      allow create: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(incoming()) && (
        isAdmin() || (
          incoming().studentUid == request.auth.uid &&
          (incoming().status == 'PRESENT' || incoming().status == 'P') &&
          incoming().source == 'QR_SCAN'
        )
      );
      allow update: if (isAdmin() && isValidId(attendanceId) && isValidAttendance(incoming())) || (
        isSignedIn() &&
        incoming().studentUid == request.auth.uid &&
        resource != null && resource.data.studentUid == request.auth.uid &&
        (incoming().status == 'PRESENT' || incoming().status == 'P') &&
        incoming().source == 'QR_SCAN' &&
        isValidAttendance(incoming())
      );
      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow get: if isSignedIn() && isValidId(announcementId);
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(announcementId) && isValidAnnouncement(incoming());
      allow delete: if isAdmin();
    }

    // Holidays & Non-class Days
    match /holidays/{holidayId} {
      allow get: if isSignedIn() && isValidId(holidayId);
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(holidayId) && isValidHoliday(incoming());
      allow delete: if isAdmin();
    }

    // Audit Logs (Only mdausafmohiuddin@gmail.com)
    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(logId);
    }

    // Institute Settings
    match /settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId);
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }

    // Excel Synchronization Jobs
    match /excel_sync_jobs/{jobId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(jobId);
    }

    // Finalized Dates (Admin can write, signed-in users can read)
    match /finalized_dates/{dateId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(dateId);
    }

    // Distributed Concurrency Locks (Serialized workbook updates across serverless instances)
    match /locks/{lockId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(lockId);
    }

    // Real-Time Location Security Incidents (Only sole admin can read and review)
    match /location_incidents/{incidentId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(incidentId);
      allow update: if isAdmin() && isValidId(incidentId);
      allow delete: if isAdmin() && isValidId(incidentId);
    }

    // Direct Push Subscriptions
    match /push_subscriptions/{subId} {
      allow get: if isSignedIn() && (request.auth.uid == subId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && isValidId(subId) && (request.auth.uid == subId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == subId || isAdmin());
    }

    // Direct Notifications (Targeted or Broadcast)
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (
        isAdmin() ||
        (resource != null && (resource.data.recipientUid == 'ALL' || resource.data.recipientUid == request.auth.uid))
      );
      allow list: if isSignedIn();
      allow create: if isAdmin() && isValidId(notificationId);
      allow update: if isSignedIn() && isValidId(notificationId) && (
        isAdmin() ||
        (resource != null && (resource.data.recipientUid == request.auth.uid || resource.data.recipientUid == 'ALL'))
      );
      allow delete: if isAdmin();
    }
  }
}
